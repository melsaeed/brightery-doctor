#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
endif

override_dh_install:
	dh_install
	# Debian Python policy: use the distribution interpreter in the .deb.
	sed -i '1s|^#!/usr/bin/env python3$$|#!/usr/bin/python3|' debian/brightery-doctor/usr/bin/brightery-doctor
